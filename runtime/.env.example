# Copie para runtime/.env e ajuste os valores.
# runtime/.env é ignorado pelo git (ver .gitignore).

# --- PostGIS ---
POSTGRES_DB=roteamento
POSTGRES_USER=roteamento
POSTGRES_PASSWORD=troque-esta-senha

# --- Nominatim (só usado se subir o profile "geocoding") ---
NOMINATIM_PASSWORD=troque-esta-senha

# --- Caddy / HTTPS ---
# Dominio que o Caddy vai servir com certificado automatico (Let's Encrypt).
# Ex.: um subdominio gratuito do DuckDNS apontando pro IP do servidor.
SITE_ADDRESS=roteamento.duckdns.org
