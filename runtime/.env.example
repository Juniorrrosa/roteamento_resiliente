# Copie para runtime/.env e ajuste os valores.
# runtime/.env é ignorado pelo git (ver .gitignore).

# --- PostGIS ---
POSTGRES_DB=roteamento
POSTGRES_USER=roteamento
POSTGRES_PASSWORD=troque-esta-senha

# --- Nominatim (só usado se subir o profile "geocoding") ---
NOMINATIM_PASSWORD=troque-esta-senha
