# Copie para scraper/.env e ajuste conforme o ambiente.
# scraper/.env e gitignored.

# URL do backend FastAPI (POST /alagamentos/snapshot, POST /geocode).
# Em compose, troque "localhost" por "backend".
BACKEND_URL=http://localhost:8000

# URL da pagina do CGE-SP. Mude apenas se a CGE migrar de endereco.
CGE_URL=https://www.cgesp.org/v3/alagamentos.jsp

# Timeouts (segundos)
PAGE_LOAD_TIMEOUT=30
ELEMENT_WAIT_TIMEOUT=15
HTTP_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Headless: nunca desligar em producao. Util em False para debug local.
HEADLESS=true
