# Copie para backend/.env e ajuste os valores.
# backend/.env e gitignored (ver .gitignore na raiz).

# Conexao com o PostGIS. Em compose, troque "localhost" por "postgis".
DATABASE_URL=postgresql+asyncpg://roteamento:CHANGEME@localhost:5432/roteamento

# URLs dos servicos auxiliares. Em compose, troque "localhost" por o nome do servico.
VALHALLA_URL=http://localhost:8002
NOMINATIM_URL=http://localhost:8080

# Parametro Q do paper ERMAC (sensibilidade ao historico)
ERMAC_Q=10.0

# Logging
LOG_LEVEL=INFO

# CORS — para dev libera tudo. Em prod, ajustar para domain especifico.
CORS_ORIGINS=*
